# Copy to backend/.env and change every value marked change-me.
SECRET_KEY=change-me-long-random-string
SYNC_SHARED_KEY=change-me-another-random-string
DATABASE_URL=sqlite:///./shwemuse.db
SEED_ON_START=true
CORS_ORIGINS=http://localhost:8002,http://127.0.0.1:8002

# Offline site server only
SITE=
CLOUD_URL=
SYNC_KEY=
QR_BASE_URL=

# Cloud read-only mirror of a site (optional)
MIRROR_MODE=false
MIRROR_INTERNAL_KEY=
